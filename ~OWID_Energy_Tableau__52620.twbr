            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qilly508yxdw615ldf7t1qhfyta'>
            <column caption='Nepal Population (Bench Marks)' datatype='integer' name='[CF (copy) (copy)_1881310888923137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [year] : MAX(IF [country] = &quot;Nepal&quot; THEN [population] END) }' />
            </column>
            <column caption='Peer Group Filter' datatype='string' name='[CF (copy)_1881310890758147]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; THEN &quot;Nepal&quot;&#10;ELSEIF &#10;    [population] &gt;= [CF (copy) (copy)_1881310888923137] * (1 - [Parameters].[Parameter 6]) &#10;    AND [population] &lt;= [CF (copy) (copy)_1881310888923137] * (1 + [Parameters].[Parameter 6])&#10;    AND [gdp] &gt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 - [Parameters].[Population Buffer % (copy)_1881310888824832]) &#10;    AND [gdp] &lt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 + [Parameters].[Population Buffer % (copy)_1881310888824832])&#10;THEN &quot;Peer Countries&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Metric for Ranking' datatype='real' name='[CF (copy)_1881310891794436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([renewables_share_elec])' />
            </column>
            <column caption='Peer Rank' datatype='integer' name='[CF (copy)_1881310894952453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([CF (copy)_1881310891794436], &apos;desc&apos;)'>
