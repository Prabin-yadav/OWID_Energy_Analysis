            </column>
            <column caption='Solar &amp; Wind Maturity' datatype='real' name='[Calculation_1477789476700161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([solar_electricity]) + SUM([wind_electricity])) / SUM([electricity_generation])' />
            </column>
            <column caption='Nepal GDP (Bench Marks)' datatype='integer' name='[Nepal Population (Bench Marks) (copy)_1881310889693186]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [year] : MAX(IF [country] = &quot;Nepal&quot; THEN [gdp] END) }' />
