      </column>
      <column caption='Demand Gap (Current vs Projected)' datatype='real' name='[. (copy)_1357051468693511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electricity_generation]) - SUM([electricity_demand])' />
      </column>
      <column caption='Renewable Share of Generation' datatype='real' name='[. (copy)_1357051471257610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([renewables_electricity]) / SUM([electricity_generation])' />
      </column>
      <column caption='Non-Hydro Renewable Share' datatype='real' name='[. (copy)_1357051471380491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([solar_electricity]) + SUM([wind_electricity])) / SUM([electricity_generation])' />
      </column>
      <column caption='Energy Independence Score' datatype='real' name='[. (copy)_1357051471462412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - AVG([net_elec_imports_share_demand] / 100)' />
      </column>
      <column caption='Regional Electricity Output' datatype='real' name='[. (copy)_1357051471609869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electricity_generation])' />
      </column>
      <column caption='Renewable Penetration' datatype='real' name='[. (copy)_1357051471704078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([renewables_share_elec])' />
      </column>
      <column caption='Projected Population' datatype='integer' name='[. (copy)_1357051471785999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([population])' />
      </column>
      <column caption='Dynamic Grouping' datatype='string' name='[CF (copy 2)_1477789614276633]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &quot;SAARC&quot; THEN &#10;    IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;ASEAN&quot; THEN &#10;    IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;Vietnam&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;BRICS&quot; THEN &#10;    IF [country] IN (&quot;Brazil&quot;, &quot;Russia&quot;, &quot;India&quot;, &quot;China&quot;, &quot;South Africa&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;G7&quot; THEN &#10;    IF [country] IN (&quot;Canada&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;EU&quot; THEN &#10;    IF [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Croatia&quot;, &quot;Cyprus&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &#10;    &quot;Ireland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Malta&quot;, &quot;Netherlands&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;OECD&quot; THEN &#10;    IF [country] IN (&quot;Australia&quot;, &quot;Austria&quot;, &quot;Belgium&quot;, &quot;Canada&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Costa Rica&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &#10;    &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Israel&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;South Korea&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Mexico&quot;, &quot;Netherlands&quot;, &quot;New Zealand&quot;, &quot;Norway&quot;, &#10;    &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Switzerland&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;OPEC&quot; THEN&#10;    IF [country] IN (&quot;Algeria&quot;, &quot;Congo&quot;, &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Iran&quot;, &quot;Iraq&quot;, &quot;Kuwait&quot;, &quot;Libya&quot;, &quot;Nigeria&quot;, &quot;Saudi Arabia&quot;, &quot;United Arab Emirates&quot;, &quot;Venezuela&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;NORTHERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Algeria&quot;, &quot;Egypt&quot;, &quot;Libya&quot;, &quot;Morocco&quot;, &quot;Sudan&quot;, &quot;Tunisia&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;WESTERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Benin&quot;, &quot;Burkina Faso&quot;, &quot;Cape Verde&quot;, &quot;Cote d&apos;Ivoire&quot;, &quot;Gambia&quot;, &quot;Ghana&quot;, &quot;Guinea&quot;, &quot;Guinea-Bissau&quot;, &quot;Liberia&quot;, &#10;    &quot;Mali&quot;, &quot;Mauritania&quot;, &quot;Niger&quot;, &quot;Nigeria&quot;, &quot;Senegal&quot;, &quot;Sierra Leone&quot;, &quot;Togo&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;CENTRAL AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Angola&quot;, &quot;Cameroon&quot;, &quot;Central African Republic&quot;, &quot;Chad&quot;, &quot;Congo&quot;, &quot;Democratic Republic of Congo&quot;, &#10;    &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Sao Tome and Principe&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;EASTERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Burundi&quot;, &quot;Comoros&quot;, &quot;Djibouti&quot;, &quot;Eritrea&quot;, &quot;Ethiopia&quot;, &quot;Kenya&quot;, &quot;Madagascar&quot;, &quot;Malawi&quot;, &quot;Mauritius&quot;, &quot;Mozambique&quot;, &#10;    &quot;Rwanda&quot;, &quot;Seychelles&quot;, &quot;Somalia&quot;, &quot;South Sudan&quot;, &quot;Tanzania&quot;, &quot;Uganda&quot;, &quot;Zambia&quot;, &quot;Zimbabwe&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;SOUTHERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Botswana&quot;, &quot;Eswatini&quot;, &quot;Lesotho&quot;, &quot;Namibia&quot;, &quot;South Africa&quot;) &#10;THEN [country] END&#10;&#10;// --- AMERICAS ---&#10;WHEN &quot;NORTH AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Bermuda&quot;, &quot;Canada&quot;, &quot;United States&quot;) THEN [country] END&#10;&#10;WHEN &quot;CENTRAL AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Belize&quot;, &quot;Costa Rica&quot;, &quot;El Salvador&quot;, &quot;Guatemala&quot;, &quot;Honduras&quot;, &quot;Mexico&quot;, &quot;Nicaragua&quot;, &quot;Panama&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;CARIBBEAN&quot; THEN &#10;    IF [country] IN (&quot;Antigua and Barbuda&quot;, &quot;Aruba&quot;, &quot;Bahamas&quot;, &quot;Barbados&quot;, &quot;Cuba&quot;, &quot;Curacao&quot;, &quot;Dominica&quot;, &quot;Dominican Republic&quot;, &quot;Grenada&quot;, &#10;    &quot;Haiti&quot;, &quot;Jamaica&quot;, &quot;Martinique&quot;, &quot;Puerto Rico&quot;, &quot;Trinidad and Tobago&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;SOUTH AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Argentina&quot;, &quot;Bolivia&quot;, &quot;Brazil&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Ecuador&quot;, &quot;Guyana&quot;, &quot;Paraguay&quot;, &quot;Peru&quot;, &quot;Suriname&quot;, &quot;Uruguay&quot;, &quot;Venezuela&quot;) &#10;THEN [country] END&#10;&#10;// --- ASIA ---&#10;WHEN &quot;CENTRAL ASIA&quot; THEN &#10;    IF [country] IN (&quot;Kazakhstan&quot;, &quot;Kyrgyzstan&quot;, &quot;Tajikistan&quot;, &quot;Turkmenistan&quot;, &quot;Uzbekistan&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;EAST ASIA&quot; THEN &#10;    IF [country] IN (&quot;China&quot;, &quot;Hong Kong&quot;, &quot;Japan&quot;, &quot;Macao&quot;, &quot;Mongolia&quot;, &quot;North Korea&quot;, &quot;South Korea&quot;, &quot;Taiwan&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;SOUTH ASIA&quot; THEN &#10;    IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;SOUTH EAST ASIA&quot; THEN &#10;    IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;East Timor&quot;, &quot;Vietnam&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;WEST ASIA&quot; THEN &#10;    IF [country] IN (&quot;Armenia&quot;, &quot;Azerbaijan&quot;, &quot;Bahrain&quot;, &quot;Cyprus&quot;, &quot;Georgia&quot;,&quot;Iran&quot;, &quot;Iraq&quot;, &quot;Israel&quot;, &quot;Jordan&quot;, &quot;Kuwait&quot;, &quot;Lebanon&quot;, &quot;Oman&quot;, &#10;    &quot;Palestine&quot;, &quot;Qatar&quot;, &quot;Saudi Arabia&quot;, &quot;Syria&quot;, &quot;Turkey&quot;, &quot;United Arab Emirates&quot;, &quot;Yemen&quot;) &#10;THEN [country] END&#10;&#10;// --- EUROPE ---&#10;WHEN &quot;EAST EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Belarus&quot;, &quot;Bulgaria&quot;, &quot;Czechia&quot;, &quot;Hungary&quot;, &quot;Moldova&quot;, &quot;Poland&quot;, &quot;Romania&quot;, &quot;Russia&quot;, &quot;Slovakia&quot;, &quot;Ukraine&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;NORTH EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Norway&quot;, &quot;Sweden&quot;, &quot;United Kingdom&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;SOUTH EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Albania&quot;, &quot;Bosnia and Herzegovina&quot;, &quot;Croatia&quot;, &quot;Gibraltar&quot;, &quot;Greece&quot;, &quot;Italy&quot;, &quot;Malta&quot;, &quot;Montenegro&quot;, &quot;North Macedonia&quot;, &quot;Portugal&quot;, &quot;Serbia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;WEST EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Luxembourg&quot;, &quot;Netherlands&quot;, &quot;Switzerland&quot;) &#10;THEN [country] END&#10;&#10;// --- OCEANIA ---&#10;WHEN &quot;AUSTRALIA &amp; NEW ZEALAND&quot; THEN &#10;    IF [country] IN (&quot;Australia&quot;, &quot;New Zealand&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;MELANESIA&quot; THEN &#10;    IF [country] IN (&quot;Fiji&quot;, &quot;Papua New Guinea&quot;, &quot;Solomon Islands&quot;, &quot;Vanuatu&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;MICRONESIA&quot; THEN &#10;    IF [country] IN (&quot;Kiribati&quot;, &quot;Micronesia (country)&quot;, &quot;Nauru&quot;) &#10;THEN [country] END&#10;&#10;WHEN &quot;POLYNESIA&quot; THEN &#10;    IF [country] IN (&quot;American Samoa&quot;, &quot;Samoa&quot;, &quot;Tonga&quot;, &quot;Tuvalu&quot;) &#10;THEN [country] END&#10;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Solar + Wind Share' datatype='real' name='[CF (copy 2)_1848531625644032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[solar_share_elec] + [wind_share_elec]' />
      </column>
      <column caption='Total Fossil Dependency' datatype='real' name='[CF (copy 2)_1848531625807873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([primary_energy_consumption] - [low_carbon_electricity]) / [primary_energy_consumption]' />
      </column>
      <column caption='Dynamic Metric Switcher' datatype='real' name='[CF (copy) (copy)_1477789479092230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN &quot;Hydro Electricity&quot; &#10;THEN [hydro_electricity] &#10;WHEN &quot;Solar Electricity&quot; &#10;THEN [solar_electricity] &#10;ELSE [renewables_electricity] &#10;END' />
      </column>
      <column caption='Heatmap Visibility' datatype='string' name='[CF (copy) (copy)_1640998508843008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &quot;Nepal &amp; Neighbors&quot; THEN&#10;    IF [country] = &quot;Nepal&quot; OR [country] IN (&quot;India&quot;, &quot;China&quot;, &quot;Bhutan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;SAARC&quot; THEN&#10;    IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;NATO&quot; THEN&#10;    IF [country] IN (&quot;Albania&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Canada&quot;, &quot;Croatia&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Montenegro&quot;, &quot;Netherlands&quot;, &quot;North Macedonia&quot;, &quot;Norway&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;G7&quot; THEN&#10;    IF [country] IN (&quot;Canada&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;BRICS&quot; THEN&#10;    IF [country] IN (&quot;Brazil&quot;, &quot;Russia&quot;, &quot;India&quot;, &quot;China&quot;, &quot;South Africa&quot;, &quot;Egypt&quot;, &quot;Ethiopia&quot;, &quot;Iran&quot;, &quot;United Arab Emirates&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;ASEAN&quot; THEN&#10;    IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;Vietnam&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;EU&quot; THEN&#10;    IF [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Croatia&quot;, &quot;Cyprus&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Ireland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Malta&quot;, &quot;Netherlands&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;WHEN &quot;G20&quot; THEN&#10;    IF [country] IN (&quot;Argentina&quot;, &quot;Australia&quot;, &quot;Brazil&quot;, &quot;Canada&quot;, &quot;China&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;India&quot;, &quot;Indonesia&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;Mexico&quot;, &quot;Russia&quot;, &quot;Saudi Arabia&quot;, &quot;South Africa&quot;, &quot;South Korea&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    THEN &quot;Show&quot; END&#10;&#10;/* For Continents, this returns &quot;Show&quot; for every country that has a continent assigned */&#10;WHEN &quot;By Continent&quot; THEN &quot;Show&quot;&#10;&#10;WHEN &quot;By Subcontinent&quot; THEN &quot;Show&quot;&#10;&#10;END' />
      </column>
      <column caption='WaterFall Sizing' datatype='real' name='[CF (copy) (copy)_1640998510268417]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='-[energy_cons_change_twh]' />
      </column>
      <column caption='Selected Group' datatype='boolean' name='[CF (copy) (copy)_1801458660552704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL(&#10;    CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &quot;NEPAL&quot; THEN IF [country] IN (&quot;NEPAL&quot;) THEN &quot;MATCH&quot; END&#10;    &#10;    WHEN &quot;SAARC&quot; THEN &#10;        IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;        THEN &quot;Match&quot; END&#10;&#10;    WHEN &quot;ASEAN&quot; THEN &#10;        IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;Vietnam&quot;) &#10;        THEN &quot;MATCH&quot; END&#10;&#10;WHEN &quot;BRICS&quot; THEN &#10;    IF [country] IN (&quot;Brazil&quot;, &quot;Russia&quot;, &quot;India&quot;, &quot;China&quot;, &quot;South Africa&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;G7&quot; THEN &#10;    IF [country] IN (&quot;Canada&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;EU&quot; THEN &#10;    IF [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Croatia&quot;, &quot;Cyprus&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &#10;    &quot;Ireland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Malta&quot;, &quot;Netherlands&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;OECD&quot; THEN &#10;    IF [country] IN (&quot;Australia&quot;, &quot;Austria&quot;, &quot;Belgium&quot;, &quot;Canada&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Costa Rica&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &#10;    &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Israel&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;South Korea&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Mexico&quot;, &quot;Netherlands&quot;, &quot;New Zealand&quot;, &quot;Norway&quot;, &#10;    &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Switzerland&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;OPEC&quot; THEN&#10;    IF [country] IN (&quot;Algeria&quot;, &quot;Congo&quot;, &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Iran&quot;, &quot;Iraq&quot;, &quot;Kuwait&quot;, &quot;Libya&quot;, &quot;Nigeria&quot;, &quot;Saudi Arabia&quot;, &quot;United Arab Emirates&quot;, &quot;Venezuela&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;NORTHERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Algeria&quot;, &quot;Egypt&quot;, &quot;Libya&quot;, &quot;Morocco&quot;, &quot;Sudan&quot;, &quot;Tunisia&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;WESTERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Benin&quot;, &quot;Burkina Faso&quot;, &quot;Cape Verde&quot;, &quot;Cote d&apos;Ivoire&quot;, &quot;Gambia&quot;, &quot;Ghana&quot;, &quot;Guinea&quot;, &quot;Guinea-Bissau&quot;, &quot;Liberia&quot;, &#10;    &quot;Mali&quot;, &quot;Mauritania&quot;, &quot;Niger&quot;, &quot;Nigeria&quot;, &quot;Senegal&quot;, &quot;Sierra Leone&quot;, &quot;Togo&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;CENTRAL AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Angola&quot;, &quot;Cameroon&quot;, &quot;Central African Republic&quot;, &quot;Chad&quot;, &quot;Congo&quot;, &quot;Democratic Republic of Congo&quot;, &#10;    &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Sao Tome and Principe&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;EASTERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Burundi&quot;, &quot;Comoros&quot;, &quot;Djibouti&quot;, &quot;Eritrea&quot;, &quot;Ethiopia&quot;, &quot;Kenya&quot;, &quot;Madagascar&quot;, &quot;Malawi&quot;, &quot;Mauritius&quot;, &quot;Mozambique&quot;, &#10;    &quot;Rwanda&quot;, &quot;Seychelles&quot;, &quot;Somalia&quot;, &quot;South Sudan&quot;, &quot;Tanzania&quot;, &quot;Uganda&quot;, &quot;Zambia&quot;, &quot;Zimbabwe&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;SOUTHERN AFRICA&quot; THEN &#10;    IF [country] IN (&quot;Botswana&quot;, &quot;Eswatini&quot;, &quot;Lesotho&quot;, &quot;Namibia&quot;, &quot;South Africa&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;// --- AMERICAS ---&#10;WHEN &quot;NORTH AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Bermuda&quot;, &quot;Canada&quot;, &quot;United States&quot;)  THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;CENTRAL AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Belize&quot;, &quot;Costa Rica&quot;, &quot;El Salvador&quot;, &quot;Guatemala&quot;, &quot;Honduras&quot;, &quot;Mexico&quot;, &quot;Nicaragua&quot;, &quot;Panama&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;CARIBBEAN&quot; THEN &#10;    IF [country] IN (&quot;Antigua and Barbuda&quot;, &quot;Aruba&quot;, &quot;Bahamas&quot;, &quot;Barbados&quot;, &quot;Cuba&quot;, &quot;Curacao&quot;, &quot;Dominica&quot;, &quot;Dominican Republic&quot;, &quot;Grenada&quot;, &#10;    &quot;Haiti&quot;, &quot;Jamaica&quot;, &quot;Martinique&quot;, &quot;Puerto Rico&quot;, &quot;Trinidad and Tobago&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;SOUTH AMERICA&quot; THEN &#10;    IF [country] IN (&quot;Argentina&quot;, &quot;Bolivia&quot;, &quot;Brazil&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Ecuador&quot;, &quot;Guyana&quot;, &quot;Paraguay&quot;, &quot;Peru&quot;, &quot;Suriname&quot;, &quot;Uruguay&quot;, &quot;Venezuela&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;// --- ASIA ---&#10;WHEN &quot;CENTRAL ASIA&quot; THEN &#10;    IF [country] IN (&quot;Kazakhstan&quot;, &quot;Kyrgyzstan&quot;, &quot;Tajikistan&quot;, &quot;Turkmenistan&quot;, &quot;Uzbekistan&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;EAST ASIA&quot; THEN &#10;    IF [country] IN (&quot;China&quot;, &quot;Hong Kong&quot;, &quot;Japan&quot;, &quot;Macao&quot;, &quot;Mongolia&quot;, &quot;North Korea&quot;, &quot;South Korea&quot;, &quot;Taiwan&quot;) &#10; THEN &quot;Match&quot; END&#10;WHEN &quot;SOUTH ASIA&quot; THEN &#10;    IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;SOUTH EAST ASIA&quot; THEN &#10;    IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;East Timor&quot;, &quot;Vietnam&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;WEST ASIA&quot; THEN &#10;    IF [country] IN (&quot;Armenia&quot;, &quot;Azerbaijan&quot;, &quot;Bahrain&quot;, &quot;Cyprus&quot;, &quot;Georgia&quot;,&quot;Iran&quot;, &quot;Iraq&quot;, &quot;Israel&quot;, &quot;Jordan&quot;, &quot;Kuwait&quot;, &quot;Lebanon&quot;, &quot;Oman&quot;, &#10;    &quot;Palestine&quot;, &quot;Qatar&quot;, &quot;Saudi Arabia&quot;, &quot;Syria&quot;, &quot;Turkey&quot;, &quot;United Arab Emirates&quot;, &quot;Yemen&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;// --- EUROPE ---&#10;WHEN &quot;EAST EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Belarus&quot;, &quot;Bulgaria&quot;, &quot;Czechia&quot;, &quot;Hungary&quot;, &quot;Moldova&quot;, &quot;Poland&quot;, &quot;Romania&quot;, &quot;Russia&quot;, &quot;Slovakia&quot;, &quot;Ukraine&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;NORTH EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Norway&quot;, &quot;Sweden&quot;, &quot;United Kingdom&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;SOUTH EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Albania&quot;, &quot;Bosnia and Herzegovina&quot;, &quot;Croatia&quot;, &quot;Gibraltar&quot;, &quot;Greece&quot;, &quot;Italy&quot;, &quot;Malta&quot;, &quot;Montenegro&quot;, &quot;North Macedonia&quot;, &quot;Portugal&quot;, &quot;Serbia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;WEST EUROPE&quot; THEN &#10;    IF [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Luxembourg&quot;, &quot;Netherlands&quot;, &quot;Switzerland&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;// --- OCEANIA ---&#10;WHEN &quot;AUSTRALIA &amp; NEW ZEALAND&quot; THEN &#10;    IF [country] IN (&quot;Australia&quot;, &quot;New Zealand&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;WHEN &quot;MELANESIA&quot; THEN &#10;    IF [country] IN (&quot;Fiji&quot;, &quot;Papua New Guinea&quot;, &quot;Solomon Islands&quot;, &quot;Vanuatu&quot;) &#10; THEN &quot;Match&quot; END&#10;&#10;&#10;    WHEN &quot;POLYNESIA&quot; THEN &#10;        IF [country] IN (&quot;American Samoa&quot;, &quot;Samoa&quot;, &quot;Tonga&quot;, &quot;Tuvalu&quot;) &#10;        THEN &quot;Match&quot; END&#10;&#10;    END&#10;)' />
      </column>
      <column caption='Nepal Population (Bench Marks)' datatype='integer' name='[CF (copy) (copy)_1881310888923137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [year] : MAX(IF [country] = &quot;Nepal&quot; THEN [population] END) }' />
      </column>
      <column caption='Grid Greeness' datatype='real' name='[CF (copy) (copy)_3181758972616707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([renewables_electricity]) / SUM([electricity_generation])' />
      </column>
      <column caption='Economic Efficiency' datatype='real' name='[CF (copy)_1357051461922816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gdp]) / SUM([primary_energy_consumption])' />
      </column>
      <column caption='Net Energy Independence' datatype='real' name='[CF (copy)_1357051462385665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([net_elec_imports]) / SUM([electricity_demand]))' />
      </column>
      <column caption='Carbon Footprint' datatype='real' name='[CF (copy)_1357051462909954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([carbon_intensity_elec])' />
      </column>
      <column caption='Nepal vs, World' datatype='string' name='[CF (copy)_1477789476732930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; &#10;THEN &quot;Nepal&quot; &#10;ELSE &quot;World&quot; &#10;END' />
      </column>
      <column caption='Energy Intensity' datatype='real' name='[CF (copy)_1477789476933635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([primary_energy_consumption]) / SUM([gdp])' />
      </column>
      <column caption='Electricity Access Gap (Millions)' datatype='real' name='[CF (copy)_1477789477232644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1 - ([electricity_demand] / 100)) * [population] / 1000000' />
      </column>
      <column caption='Year-over-Year Growth %' datatype='real' name='[CF (copy)_1477789479075845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([renewables_electricity])) - &#10;LOOKUP(ZN(SUM([renewables_electricity])), -1)) / &#10;ABS(LOOKUP(ZN(SUM([renewables_electricity])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Waterfall Sizing' datatype='real' name='[CF (copy)_1477789479469063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[primary_energy_consumption]' />
      </column>
      <column caption='Energy Surplus/Deficit' datatype='real' name='[CF (copy)_1477789497262088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electricity_generation]) - SUM([CF (copy)_1477789500629001])' />
      </column>
      <column caption='Scenario Demand' datatype='real' name='[CF (copy)_1477789500629001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[electricity_demand] * (1 + [Parameters].[Parameter 3])' />
      </column>
      <column caption='Country Focus Color' datatype='string' name='[CF (copy)_1477789509894154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; &#10;THEN &quot;Primary Focus&quot;&#10;ELSE [country]&#10;END' />
      </column>
      <column caption='Hydro Production' datatype='real' name='[CF (copy)_1477789517135883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([hydro_electricity])' />
      </column>
      <column caption='Solar Production' datatype='real' name='[CF (copy)_1477789517234188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([solar_electricity])' />
      </column>
      <column caption='Wild Production' datatype='real' name='[CF (copy)_1477789517348877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([wind_electricity])' />
      </column>
      <column caption='Fossil Production' datatype='real' name='[CF (copy)_1477789517475854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([fossil_electricity])' />
      </column>
      <column caption='Renewable Production' datatype='real' name='[CF (copy)_1477789523566607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([renewables_electricity])' />
      </column>
      <column caption='Peer Toggle Filter' datatype='boolean' name='[CF (copy)_1477789540864016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Nepal Only&quot; &#10;THEN &#10;    [country] = &quot;Nepal&quot;&#10;ELSE &#10;    [Peer Group]&#10;END' />
      </column>
      <column caption='Nepal Carbon Intensity' datatype='real' name='[CF (copy)_1477789541900305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; &#10;THEN [carbon_intensity_elec] &#10;END' />
      </column>
      <column caption='Carbon Intensity Bucket' datatype='integer' name='[CF (copy)_1477789543411730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([carbon_intensity_elec] / 25) * 25' />
      </column>
      <column caption='GDP per Capita' datatype='real' name='[CF (copy)_1477789583286293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gdp] / [population]' />
      </column>
      <column caption='Nepal Focus' datatype='string' name='[CF (copy)_1477789596160022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; &#10;THEN &quot;Nepal&quot; &#10;ELSEIF [country] &#10;IN (&quot;India&quot;, &quot;China&quot;, &quot;Bhutan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;) &#10;THEN &quot;Neighbors&quot;&#10;ELSE &quot;Others&quot; &#10;END' />
      </column>
      <column caption='Group Highlight' datatype='string' name='[CF (copy)_1477789600645143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &quot;Nepal &amp; Neighbors&quot; THEN &#10;    IF [country] = &quot;Nepal&quot; THEN &quot;Nepal&quot;&#10;    ELSEIF [country] IN (&quot;India&quot;, &quot;China&quot;, &quot;Bhutan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;) THEN &quot;Neighbors&quot;&#10;    ELSE &quot;Others&quot; END&#10;&#10;WHEN &quot;SAARC&quot; THEN&#10;    IF [country] = &quot;Nepal&quot; THEN &quot;Nepal&quot;&#10;    ELSEIF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) THEN &quot;SAARC&quot;&#10;    ELSE &quot;Others&quot; END&#10;&#10;WHEN &quot;NATO&quot; THEN&#10;    IF [country] = &quot;Nepal&quot; THEN &quot;Nepal&quot;&#10;    ELSEIF [country] IN (&quot;Albania&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Canada&quot;, &quot;Croatia&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Montenegro&quot;, &quot;Netherlands&quot;, &quot;North Macedonia&quot;, &quot;Norway&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) THEN &quot;NATO&quot;&#10;    ELSE &quot;Others&quot; END&#10;&#10;WHEN &quot;By Continent&quot; THEN&#10;    IF [country] IN (&quot;China&quot;, &quot;India&quot;, &quot;Japan&quot;, &quot;Nepal&quot;, &quot;Vietnam&quot;, &quot;Thailand&quot;, &quot;Indonesia&quot;, &quot;South Korea&quot;) THEN &quot;Asia&quot;&#10;    ELSEIF [country] IN (&quot;United Kingdom&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Spain&quot;, &quot;Norway&quot;, &quot;Sweden&quot;, &quot;Poland&quot;) THEN &quot;Europe&quot;&#10;    ELSEIF [country] IN (&quot;Nigeria&quot;, &quot;Egypt&quot;, &quot;South Africa&quot;, &quot;Kenya&quot;, &quot;Ethiopia&quot;, &quot;Ghana&quot;) THEN &quot;Africa&quot;&#10;    ELSEIF [country] IN (&quot;Australia&quot;, &quot;New Zealand&quot;, &quot;Fiji&quot;, &quot;Papua New Guinea&quot;) THEN &quot;Oceania&quot;&#10;    ELSE &quot;Others&quot; END&#10;&#10;END' />
      </column>
      <column caption='Nepal Filter' datatype='boolean' name='[CF (copy)_1477789613223960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country] = &quot;Nepal&quot;' />
      </column>
      <column caption='Peer Group Filter' datatype='string' name='[CF (copy)_1881310890758147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;Nepal&quot; THEN &quot;Nepal&quot;&#10;ELSEIF &#10;    [population] &gt;= [CF (copy) (copy)_1881310888923137] * (1 - [Parameters].[Parameter 6]) &#10;    AND [population] &lt;= [CF (copy) (copy)_1881310888923137] * (1 + [Parameters].[Parameter 6])&#10;    AND [gdp] &gt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 - [Parameters].[Population Buffer % (copy)_1881310888824832]) &#10;    AND [gdp] &lt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 + [Parameters].[Population Buffer % (copy)_1881310888824832])&#10;THEN &quot;Peer Countries&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Metric for Ranking' datatype='real' name='[CF (copy)_1881310891794436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([renewables_share_elec])' />
      </column>
      <column caption='Peer Rank' datatype='integer' name='[CF (copy)_1881310894952453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([CF (copy)_1881310891794436], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Non-Electric Energy' datatype='real' name='[CF (copy)_1881310908149766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[primary_energy_consumption] - [electricity_generation]' />
      </column>
      <column caption='Master Dashboard View' datatype='boolean' name='[CF (copy)_1881310969176071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    &#10;    WHEN &quot;NEPAL&quot; THEN [country] = &quot;Nepal&quot;&#10;&#10;    WHEN &quot;ECONOMIC PEER&quot; THEN &#10;        ([country] = &quot;Nepal&quot; OR &#10;        (([population]) &gt;= [CF (copy) (copy)_1881310888923137] * (1 - [Parameters].[Parameter 6]) &#10;         AND ([population]) &lt;= [CF (copy) (copy)_1881310888923137] * (1 + [Parameters].[Parameter 6])&#10;         AND ([gdp]) &gt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 - [Parameters].[Population Buffer % (copy)_1881310888824832]) &#10;         AND ([gdp]) &lt;= [Nepal Population (Bench Marks) (copy)_1881310889693186] * (1 + [Parameters].[Population Buffer % (copy)_1881310888824832])))&#10;&#10;    WHEN &quot;LANDLOCKED ASIA&quot; THEN &#10;        [country] IN (&quot;Afghanistan&quot;, &quot;Armenia&quot;, &quot;Azerbaijan&quot;, &quot;Bhutan&quot;, &quot;Kazakhstan&quot;, &quot;Kyrgyzstan&quot;, &quot;Laos&quot;, &quot;Mongolia&quot;, &quot;Nepal&quot;, &quot;Tajikistan&quot;, &quot;Turkmenistan&quot;, &quot;Uzbekistan&quot;)&#10;    &#10;    WHEN &quot;LANDLOCKED AFRICA&quot; THEN &#10;        [country] IN (&quot;Botswana&quot;, &quot;Burkina Faso&quot;, &quot;Burundi&quot;, &quot;Central African Republic&quot;, &quot;Chad&quot;, &quot;Eswatini&quot;, &quot;Ethiopia&quot;, &quot;Lesotho&quot;, &quot;Malawi&quot;, &quot;Mali&quot;, &quot;Nepal&quot;, &quot;Niger&quot;, &quot;Rwanda&quot;, &quot;South Sudan&quot;, &quot;Uganda&quot;, &quot;Zambia&quot;, &quot;Zimbabwe&quot;)&#10;    &#10;    WHEN &quot;LANDLOCKED EUROPE&quot; THEN &#10;        [country] IN (&quot;Andorra&quot;, &quot;Austria&quot;, &quot;Belarus&quot;, &quot;Czechia&quot;, &quot;Hungary&quot;, &quot;Liechtenstein&quot;, &quot;Luxembourg&quot;, &quot;Moldova&quot;, &quot;Nepal&quot;,&quot;North Macedonia&quot;, &quot;San Marino&quot;, &quot;Serbia&quot;, &quot;Slovakia&quot;, &quot;Switzerland&quot;, &quot;Vatican City&quot;)&#10;    &#10;    WHEN &quot;LANDLOCKED SOUTH AMERICA&quot; THEN &#10;        [country] IN (&quot;Bolivia&quot;, &quot;Nepal&quot;, &quot;Paraguay&quot;)&#10;&#10;    WHEN &quot;POPULATION PEERS&quot; THEN &#10;        [country] IN (&quot;Angola&quot;, &quot;Ghana&quot;, &quot;Madagascar&quot;, &quot;Malaysia&quot;, &quot;Mozambique&quot;, &quot;Nepal&quot;, &quot;Ivory Coast&quot;, &quot;Uzbekistan&quot;, &quot;Venezuela&quot;, &quot;Yemen&quot;)&#10;&#10;    WHEN &quot;GDP PEERS&quot; THEN &#10;        [country] IN (&quot;Azerbaijan&quot;, &quot;Bahrain&quot;, &quot;Bolivia&quot;, &quot;Cameroon&quot;, &quot;Jordan&quot;, &quot;Latvia&quot;, &quot;Libya&quot;, &quot;Nepal&quot;, &quot;Paraguay&quot;, &quot;Slovenia&quot;, &quot;Uganda&quot;)&#10;&#10;    WHEN &quot;LAND SIZE PEERS&quot; THEN &#10;        [country] IN (&quot;Bangladesh&quot;, &quot;Greece&quot;, &quot;Nepal&quot;, &quot;Nicaragua&quot;, &quot;Suriname&quot;, &quot;Tajikistan&quot;, &quot;Tunisia&quot;)&#10;&#10;    WHEN &quot;SAARC&quot; THEN &#10;        [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;)&#10;    WHEN &quot;ASEAN&quot; THEN &#10;        [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;Vietnam&quot;)&#10;    WHEN &quot;BRICS&quot; THEN &#10;        [country] IN (&quot;Brazil&quot;, &quot;Russia&quot;, &quot;India&quot;, &quot;China&quot;, &quot;South Africa&quot;)&#10;    WHEN &quot;G7&quot; THEN &#10;        [country] IN (&quot;Canada&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;)&#10;    WHEN &quot;EU&quot; THEN &#10;        [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Croatia&quot;, &quot;Cyprus&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &#10;    &quot;Ireland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Malta&quot;, &quot;Netherlands&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;) &#10;    WHEN &quot;OECD&quot; THEN&#10;        [country] IN (&quot;Australia&quot;, &quot;Austria&quot;, &quot;Belgium&quot;, &quot;Canada&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Costa Rica&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &#10;    &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Israel&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;South Korea&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Mexico&quot;, &quot;Netherlands&quot;, &quot;New Zealand&quot;, &quot;Norway&quot;, &#10;    &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Switzerland&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    WHEN &quot;OPEC&quot; THEN&#10;        [country] IN (&quot;Algeria&quot;, &quot;Congo&quot;, &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Iran&quot;, &quot;Iraq&quot;, &quot;Kuwait&quot;, &quot;Libya&quot;, &quot;Nigeria&quot;, &quot;Saudi Arabia&quot;, &quot;United Arab Emirates&quot;, &quot;Venezuela&quot;) &#10;    WHEN &quot;NORTHERN AFRICA&quot; THEN &#10;        [country] IN (&quot;Algeria&quot;, &quot;Egypt&quot;, &quot;Libya&quot;, &quot;Morocco&quot;, &quot;Sudan&quot;, &quot;Tunisia&quot;)&#10;    WHEN &quot;WESTERN AFRICA&quot; THEN &#10;        [country] IN (&quot;Benin&quot;, &quot;Burkina Faso&quot;, &quot;Cape Verde&quot;, &quot;Cote d&apos;Ivoire&quot;, &quot;Gambia&quot;, &quot;Ghana&quot;, &quot;Guinea&quot;, &quot;Guinea-Bissau&quot;, &quot;Liberia&quot;, &#10;    &quot;Mali&quot;, &quot;Mauritania&quot;, &quot;Niger&quot;, &quot;Nigeria&quot;, &quot;Senegal&quot;, &quot;Sierra Leone&quot;, &quot;Togo&quot;)&#10;    WHEN &quot;CENTRAL AFRICA&quot; THEN &#10;        [country] IN (&quot;Angola&quot;, &quot;Cameroon&quot;, &quot;Central African Republic&quot;, &quot;Chad&quot;, &quot;Congo&quot;, &quot;Democratic Republic of Congo&quot;, &#10;    &quot;Equatorial Guinea&quot;, &quot;Gabon&quot;, &quot;Sao Tome and Principe&quot;)&#10;    WHEN &quot;EASTERN AFRICA&quot; THEN &#10;        [country] IN (&quot;Burundi&quot;, &quot;Comoros&quot;, &quot;Djibouti&quot;, &quot;Eritrea&quot;, &quot;Ethiopia&quot;, &quot;Kenya&quot;, &quot;Madagascar&quot;, &quot;Malawi&quot;, &quot;Mauritius&quot;, &quot;Mozambique&quot;, &#10;    &quot;Rwanda&quot;, &quot;Seychelles&quot;, &quot;Somalia&quot;, &quot;South Sudan&quot;, &quot;Tanzania&quot;, &quot;Uganda&quot;, &quot;Zambia&quot;, &quot;Zimbabwe&quot;) &#10;    WHEN &quot;SOUTHERN AFRICA&quot; THEN &#10;        [country] IN (&quot;Botswana&quot;, &quot;Eswatini&quot;, &quot;Lesotho&quot;, &quot;Namibia&quot;, &quot;South Africa&quot;) &#10;    WHEN &quot;NORTH AMERICA&quot; THEN &#10;        [country] IN (&quot;Bermuda&quot;, &quot;Canada&quot;, &quot;United States&quot;)&#10;    WHEN &quot;CENTRAL AMERICA&quot; THEN &#10;        [country] IN (&quot;Belize&quot;, &quot;Costa Rica&quot;, &quot;El Salvador&quot;, &quot;Guatemala&quot;, &quot;Honduras&quot;, &quot;Mexico&quot;, &quot;Nicaragua&quot;, &quot;Panama&quot;) &#10;    WHEN &quot;CARIBBEAN&quot; THEN &#10;        [country] IN (&quot;Antigua and Barbuda&quot;, &quot;Aruba&quot;, &quot;Bahamas&quot;, &quot;Barbados&quot;, &quot;Cuba&quot;, &quot;Curacao&quot;, &quot;Dominica&quot;, &quot;Dominican Republic&quot;, &quot;Grenada&quot;, &#10;    &quot;Haiti&quot;, &quot;Jamaica&quot;, &quot;Martinique&quot;, &quot;Puerto Rico&quot;, &quot;Trinidad and Tobago&quot;) &#10;    WHEN &quot;SOUTH AMERICA&quot; THEN &#10;        [country] IN (&quot;Argentina&quot;, &quot;Bolivia&quot;, &quot;Brazil&quot;, &quot;Chile&quot;, &quot;Colombia&quot;, &quot;Ecuador&quot;, &quot;Guyana&quot;, &quot;Paraguay&quot;, &quot;Peru&quot;, &quot;Suriname&quot;, &quot;Uruguay&quot;, &quot;Venezuela&quot;) &#10;    WHEN &quot;CENTRAL ASIA&quot; THEN &#10;        [country] IN (&quot;Kazakhstan&quot;, &quot;Kyrgyzstan&quot;, &quot;Tajikistan&quot;, &quot;Turkmenistan&quot;, &quot;Uzbekistan&quot;) &#10;    WHEN &quot;EAST ASIA&quot; THEN &#10;        [country] IN (&quot;China&quot;, &quot;Hong Kong&quot;, &quot;Japan&quot;, &quot;Macao&quot;, &quot;Mongolia&quot;, &quot;North Korea&quot;, &quot;South Korea&quot;, &quot;Taiwan&quot;) &#10;    WHEN &quot;SOUTH ASIA&quot; THEN &#10;        [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;    WHEN &quot;SOUTH EAST ASIA&quot; THEN &#10;        [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot;, &quot;Indonesia&quot;, &quot;Laos&quot;, &quot;Malaysia&quot;, &quot;Myanmar&quot;, &quot;Philippines&quot;, &quot;Singapore&quot;, &quot;Thailand&quot;, &quot;East Timor&quot;, &quot;Vietnam&quot;) &#10;    WHEN &quot;WEST ASIA&quot; THEN &#10;        [country] IN (&quot;Armenia&quot;, &quot;Azerbaijan&quot;, &quot;Bahrain&quot;, &quot;Cyprus&quot;, &quot;Georgia&quot;,&quot;Iran&quot;, &quot;Iraq&quot;, &quot;Israel&quot;, &quot;Jordan&quot;, &quot;Kuwait&quot;, &quot;Lebanon&quot;, &quot;Oman&quot;, &#10;    &quot;Palestine&quot;, &quot;Qatar&quot;, &quot;Saudi Arabia&quot;, &quot;Syria&quot;, &quot;Turkey&quot;, &quot;United Arab Emirates&quot;, &quot;Yemen&quot;) &#10;    WHEN &quot;EAST EUROPE&quot; THEN &#10;        [country] IN (&quot;Belarus&quot;, &quot;Bulgaria&quot;, &quot;Czechia&quot;, &quot;Hungary&quot;, &quot;Moldova&quot;, &quot;Poland&quot;, &quot;Romania&quot;, &quot;Russia&quot;, &quot;Slovakia&quot;, &quot;Ukraine&quot;) &#10;    WHEN &quot;NORTH EUROPE&quot; THEN &#10;        [country] IN (&quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;Iceland&quot;, &quot;Ireland&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Norway&quot;, &quot;Sweden&quot;, &quot;United Kingdom&quot;) &#10;    WHEN &quot;SOUTH EUROPE&quot; THEN &#10;        [country] IN (&quot;Albania&quot;, &quot;Bosnia and Herzegovina&quot;, &quot;Croatia&quot;, &quot;Gibraltar&quot;, &quot;Greece&quot;, &quot;Italy&quot;, &quot;Malta&quot;, &quot;Montenegro&quot;, &quot;North Macedonia&quot;, &quot;Portugal&quot;, &quot;Serbia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;) &#10;    WHEN &quot;WEST EUROPE&quot; THEN &#10;        [country] IN (&quot;Austria&quot;, &quot;Belgium&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Luxembourg&quot;, &quot;Netherlands&quot;, &quot;Switzerland&quot;) &#10;    WHEN &quot;AUSTRALIA &amp; NEW ZEALAND&quot; THEN &#10;        [country] IN (&quot;Australia&quot;, &quot;New Zealand&quot;) &#10;    WHEN &quot;MELANESIA&quot; THEN &#10;        [country] IN (&quot;Fiji&quot;, &quot;Papua New Guinea&quot;, &quot;Solomon Islands&quot;, &quot;Vanuatu&quot;) &#10;    WHEN &quot;POLYNESIA&quot; THEN &#10;        [country] IN (&quot;American Samoa&quot;, &quot;Samoa&quot;, &quot;Tonga&quot;, &quot;Tuvalu&quot;) &#10;&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Peer Country Flag' datatype='string' name='[CF (copy)_3181758962438144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gdp]/[population] &gt;= 800&#10;AND [gdp]/[population] &lt;= 5000&#10;AND [population] &gt;= 5000000&#10;AND [population] &lt;= 50000000&#10;THEN &quot;Peer&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='GDP Growth %' datatype='real' name='[CF (copy)_3181758972428289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [year] = 2022 THEN [gdp] END) - SUM(IF [year] = 2010 THEN [gdp] END)) / SUM(IF [year] = 2010 THEN [gdp] END) * 100' />
      </column>
      <column caption='Fossil Share Change' datatype='real' name='[CF (copy)_3181758972588034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [year] = 2022 THEN [fossil_share_elec] END) -&#10;SUM(IF [year] = 2010 THEN [fossil_share_elec] END)' />
      </column>
      <column caption='Grid Greenness' datatype='string' name='[Calculation_1357051464151043]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [CF (copy) (copy)_3181758972616707] &gt; 0.4 THEN &quot;Good&quot; ELSE &quot;Check&quot; END' />
      </column>
      <column caption='Total Energy Consumption' datatype='real' name='[Calculation_1357051467509764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([primary_energy_consumption])' />
      </column>
      <column caption='Economic-Efficiency' datatype='real' name='[Calculation_1357051468275717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([primary_energy_consumption]) / (SUM([gdp]) / 1000000000)' />
      </column>
      <column caption='Growth Trajectory (Energy vs. Pop)' datatype='real' name='[Calculation_1357051468664838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([primary_energy_consumption]) / SUM([population])) * 1000' />
      </column>
      <column caption='Avg. Carbon Intensity' datatype='real' name='[Calculation_1357051470815240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([carbon_intensity_elec])' />
      </column>
      <column caption='.' datatype='real' name='[Calculation_1357051471224841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Solar &amp; Wind Maturity' datatype='real' name='[Calculation_1477789476700161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([solar_electricity]) + SUM([wind_electricity])) / SUM([electricity_generation])' />
      </column>
      <column aggregation='Sum' caption='Renewable Share Bucket' datatype='integer' name='[Carbon Intensity Bucket (copy)_1477789545721875]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([renewables_share_elec] / 5) * 5' />
      </column>
      <column caption='Country Lebel (Focus)' datatype='string' name='[Country Focus Color (copy)_1614610220703744]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &quot;Nepal &amp; Neighbors&quot; THEN&#10;    IF [country] = &quot;Nepal&quot; OR [country] IN (&quot;India&quot;, &quot;China&quot;, &quot;Bhutan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;) &#10;    THEN [country] END&#10;&#10;WHEN &quot;SAARC&quot; THEN&#10;    IF [country] IN (&quot;Afghanistan&quot;, &quot;Bangladesh&quot;, &quot;Bhutan&quot;, &quot;India&quot;, &quot;Maldives&quot;, &quot;Nepal&quot;, &quot;Pakistan&quot;, &quot;Sri Lanka&quot;) &#10;    THEN [country] END&#10;&#10;WHEN &quot;NATO&quot; THEN&#10;    IF [country] IN (&quot;Albania&quot;, &quot;Belgium&quot;, &quot;Bulgaria&quot;, &quot;Canada&quot;, &quot;Croatia&quot;, &quot;Czechia&quot;, &quot;Denmark&quot;, &quot;Estonia&quot;, &quot;Finland&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Greece&quot;, &quot;Hungary&quot;, &quot;Iceland&quot;, &quot;Italy&quot;, &quot;Latvia&quot;, &quot;Lithuania&quot;, &quot;Luxembourg&quot;, &quot;Montenegro&quot;, &quot;Netherlands&quot;, &quot;North Macedonia&quot;, &quot;Norway&quot;, &quot;Poland&quot;, &quot;Portugal&quot;, &quot;Romania&quot;, &quot;Slovakia&quot;, &quot;Slovenia&quot;, &quot;Spain&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    THEN [country] END&#10;&#10;WHEN &quot;G7&quot; THEN&#10;    IF [country] IN (&quot;Canada&quot;, &quot;France&quot;, &quot;Germany&quot;, &quot;Italy&quot;, &quot;Japan&quot;, &quot;United Kingdom&quot;, &quot;United States&quot;) &#10;    THEN [country] END&#10;&#10;WHEN &quot;BRICS&quot; THEN&#10;    IF [country] IN (&quot;Brazil&quot;, &quot;Russia&quot;, &quot;India&quot;, &quot;China&quot;, &quot;South Africa&quot;, &quot;Egypt&quot;, &quot;Ethiopia&quot;, &quot;Iran&quot;, &quot;United Arab Emirates&quot;) &#10;    THEN [country] END&#10;&#10;WHEN &quot;ASEAN&quot; THEN&#10;    IF [country] IN (&quot;Brunei&quot;, &quot;Cambodia&quot